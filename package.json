{
  "name": "container-studio",
  "private": true,
  "license": "MIT",
  "version": "0.19.1",
  "description": "Local-first FFmpeg media toolbox with SmartCut, batch processing and visual previews.",
  "homepage": "https://github.com/dewnn/container#readme",
  "bugs": {
    "url": "https://github.com/dewnn/container/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dewnn/container.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test:timeline": "node --experimental-strip-types tooling/scripts/test-timeline-range.ts",
    "test:recovery": "node --experimental-strip-types tooling/scripts/test-recovery.ts",
    "test:editor-safety": "node --experimental-strip-types tooling/scripts/test-editor-safety.ts && node --experimental-strip-types tooling/scripts/test-stage-history.ts",
    "test:project-resources": "node --experimental-strip-types tooling/scripts/test-project-resources.ts",
    "test:visual-geometry": "node --experimental-strip-types tooling/scripts/test-visual-geometry.ts && node --experimental-strip-types tooling/scripts/test-stack-geometry.ts",
    "test:release-channel": "node --experimental-strip-types tooling/scripts/test-release-channel.ts",
    "test:contracts": "node --experimental-strip-types tooling/scripts/test-ui-contracts.ts && node --experimental-strip-types tooling/scripts/test-render-feedback.ts",
    "test:ui": "pnpm test:timeline && pnpm test:recovery && pnpm test:editor-safety && pnpm test:project-resources && pnpm test:visual-geometry && pnpm test:release-channel && pnpm test:contracts",
    "test:e2e": "playwright test --config tooling/playwright.config.ts",
    "test:windows-icons": "powershell -NoProfile -ExecutionPolicy Bypass -File tooling/scripts/test-windows-icons.ps1",
    "test:installer-hooks": "powershell -NoProfile -ExecutionPolicy Bypass -File tooling/scripts/test-installer-hooks.ps1",
    "dev:register-association": "powershell -NoProfile -ExecutionPolicy Bypass -File tooling/scripts/register-dev-association.ps1",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:dev": "tauri build --config src-tauri/tauri.dev.conf.json --no-bundle && node tooling/scripts/sync-dev-exe.mjs && pnpm test:windows-icons"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-updater": "~2.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^6.1.0",
    "@tauri-apps/cli": "^2.11.5",
    "@tsconfig/svelte": "^5.0.5",
    "svelte": "^5.57.1",
    "svelte-check": "^4.3.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
