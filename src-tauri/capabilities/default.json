{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for CONTAINER",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-icon",
    "core:window:allow-set-theme",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-reveal-item-in-dir",
      "allow": [
        { "path": "$DOWNLOAD/CONTAINER Output/**" },
        { "path": "$DOWNLOAD/CONTAINER Downloads/**" }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://ffmpeg.org/download.html#build-windows" }
      ]
    }
  ]
}
