{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CONTAINER",
  "version": "0.1.0",
  "identifier": "dev.dean.container",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "CONTAINER — FFmpeg Media Toolbox",
      "width": 1440,
      "height": 900,
      "minWidth": 980,
      "minHeight": 650,
      "resizable": true,
      "center": true,
      "decorations": true,
      "backgroundColor": "#09090b",
      "dragDropEnabled": true
    }],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; img-src 'self' asset: http://asset.localhost blob: data:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
